<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Status Bar: Question Counter & Live Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvQuestionCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1 of 10"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvScoreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/shape_quiz_badge"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="10"
            android:progress="1"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/card_stroke"
            android:layout_marginBottom="16dp" />

        <!-- Category & Difficulty Chip -->
        <TextView
            android:id="@+id/tvCategoryDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computer Hardware · Easy"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <!-- Question Prompt Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What does CPU stand for in computer systems?"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4 Option Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Option 0 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/quiz_option_border"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOption0Prefix"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/shape_quiz_badge"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvOption0Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Central Processing Unit"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/ivOption0Icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:contentDescription="Status" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/quiz_option_border"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOption1Prefix"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/shape_quiz_badge"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvOption1Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Central Process Utility"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/ivOption1Icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:contentDescription="Status" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/quiz_option_border"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOption2Prefix"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="C"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/shape_quiz_badge"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvOption2Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Computer Primary Unit"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/ivOption2Icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:contentDescription="Status" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/quiz_option_border"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOption3Prefix"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="D"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/shape_quiz_badge"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvOption3Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Core Program Unit"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/ivOption3Icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:contentDescription="Status" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Explanation Card (Shown after selection) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvExplanationHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correct Answer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/quiz_correct"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvExplanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explanation goes here..."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Next / Finish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextQuestion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/quiz_btn_next"
            android:textSize="15sp"
            android:textStyle="bold"
            android:enabled="false"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary" />

    </LinearLayout>
</ScrollView>
